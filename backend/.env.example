# DeepSeek API 配置
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Redis 配置（Docker 启动后默认即可）
REDIS_URL=redis://localhost:6379/0

# Judge0 配置（本地 Docker，默认即可）
JUDGE0_URL=http://localhost:2358

# 知识库 PostgreSQL 配置（复用 Judge0 的 PostgreSQL 实例）
DATABASE_URL=postgresql+asyncpg://interview:kb_pass_2025_dev@localhost:5433/interview_kb
